{
  "name": "@kazecreator/dsh-settings-pro",
  "version": "0.5.11",
  "description": "DeepSeek Harness settings-pro plugin: IM bridge (Telegram/WeChat), DeepSeek usage, cross-restart memory, desktop pets, and a vision bridge",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "im",
    "telegram",
    "wechat",
    "usage",
    "memory",
    "pets",
    "cordis"
  ],
  "author": "kazeCreator",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pet-desktop/main.js",
    "pet-desktop/preload.js",
    "pet-desktop/package.json",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node test-plugin-apply.mjs && node test-markdown.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazecreator/dsh-settings-pro.git"
  },
  "homepage": "https://github.com/kazecreator/dsh-settings-pro#readme",
  "bugs": {
    "url": "https://github.com/kazecreator/dsh-settings-pro/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  }
}
