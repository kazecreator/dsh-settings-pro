{
  "name": "dsh-pet-desktop",
  "version": "0.1.0",
  "description": "Always-on-top desktop pet for the DeepSeek Harness (loads the harness /pet page)",
  "author": "kazeCreator",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "top.kazecreator.dsh-pet-desktop",
    "productName": "DSH Pet",
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
